{
  "name": "diorama-plugin-slots",
  "version": "0.0.5",
  "private": true,
  "description": "Diorama piece: the slot registry core and the client ctx.slots service",
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "diorama": {
    "contract": ">=0.0.5 <0.1.0",
    "id": "slots",
    "client": {
      "entry": "./lib/client.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.emit.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "diorama-kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "cordis": "4.0.0-rc.11",
    "react": "^19.0.0"
  }
}
