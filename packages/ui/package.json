{
  "name": "diorama-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Diorama client UI: React renderer over the slot registry",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.11",
    "diorama-kernel": "workspace:*",
    "diorama-plugin-slots": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "diorama-plugin-slots": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts"
}
