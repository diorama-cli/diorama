{
  "name": "@diorama-cli/diorama",
  "version": "0.0.5",
  "private": false,
  "description": "A live diorama of your files: serve any directory as a browsable scene (tree, tabs, Markdown, code, git, search).",
  "type": "module",
  "bin": {
    "diorama": "./bin/diorama"
  },
  "files": [
    "bin",
    "lib",
    "plugins",
    "web",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "diorama-kernel": "workspace:*",
    "diorama-plugin-code": "workspace:*",
    "diorama-plugin-file-tree": "workspace:*",
    "diorama-plugin-git": "workspace:*",
    "diorama-plugin-help": "workspace:*",
    "diorama-plugin-html": "workspace:*",
    "diorama-plugin-image": "workspace:*",
    "diorama-plugin-layout": "workspace:*",
    "diorama-plugin-markdown": "workspace:*",
    "diorama-plugin-palette": "workspace:*",
    "diorama-plugin-pdf": "workspace:*",
    "diorama-plugin-plaintext": "workspace:*",
    "diorama-plugin-renderer-registry": "workspace:*",
    "diorama-plugin-search-view": "workspace:*",
    "diorama-plugin-slots": "workspace:*",
    "diorama-plugin-tabs": "workspace:*",
    "diorama-plugin-theme": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diorama-cli/diorama.git"
  },
  "homepage": "https://github.com/diorama-cli/diorama#readme",
  "bugs": {
    "url": "https://github.com/diorama-cli/diorama/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "diorama",
    "file-viewer",
    "markdown",
    "git",
    "static-server",
    "cli"
  ]
}
