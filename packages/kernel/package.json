{
  "name": "diorama-kernel",
  "version": "0.0.2",
  "private": true,
  "description": "Diorama plugin kernel: Cordis boot, ctx.fs transport and page types",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/types.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./server": {
      "types": "./lib/types/server/index.d.ts",
      "default": "./lib/server.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "diorama": {
    "contract": ">=0.0.2 <0.1.0",
    "id": "kernel"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsdown && tsc -p tsconfig.emit.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.11",
    "smol-toml": "^1.9.1"
  },
  "peerDependencies": {
    "cordis": "4.0.0-rc.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  }
}
